{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sync style guide",
            "type": "shell",
            "command": "sh style/setup/style_sync.sh",
            "windows": {
                "command": "style\\setup\\style_sync.bat"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Minor update to dev",
            "type": "process",
            "command": "git",
            "args": [
                "release",
                "--minor",
                "${input:minorSummary}"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Major release dev to main",
            "type": "process",
            "command": "git",
            "args": [
                "release",
                "--major",
                "${input:releaseSummary}"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Hotfix to main",
            "type": "process",
            "command": "git",
            "args": [
                "release",
                "--hotfix",
                "${input:hotfixSummary}"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Make export zip",
            "type": "shell",
            "command": "sh .style/make_zip.sh nopause",
            "windows": {
                "command": ".style\\make_zip.bat nopause"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "releaseSummary",
            "type": "promptString",
            "description": "Summary of the release, used in the commit message"
        },
        {
            "id": "hotfixSummary",
            "type": "promptString",
            "description": "Summary of the fix, used in the commit message"
        },
        {
            "id": "minorSummary",
            "type": "promptString",
            "description": "Summary of the update, used in the commit message"
        }
    ]
}
