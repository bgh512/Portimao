        "blockReadsOutsideWorkingDirectories": true,
        "blockWritesOutsideWorkingDirectories": true,
        "additionalDirectories": []
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py session"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py notes"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep|LS|Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py boundary"
                    }
                ]
            },
            {
                "matcher": "Edit|MultiEdit|Write|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py guard"
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py command"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py tidy"
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py permission"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$CLAUDE_PROJECT_DIR/style/setup/run_tool.sh\" enforce/tools/claude_hook.py stop"
                    }
                ]
            }
        ]
    }
}
